+    else o.setPeriodicWave(waves[wave]);
+    o.frequency.setValueAtTime(f0, t);
+    if (f1 !== f0) {
+      if (glide === 'exp') o.frequency.exponentialRampToValueAtTime(Math.max(20, f1), t + dur);
+      else o.frequency.linearRampToValueAtTime(f1, t + dur);
+    }
