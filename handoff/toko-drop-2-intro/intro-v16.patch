+  }
+
+  const C = CUES;
+  // 1 · the lockup: a bright arpeggio on a 25% pulse over a soft triangle root
+  [76, 83, 88, 95].forEach((n, i) => tone(C.logo + i * 0.055, NOTE(n), 0.42 - i * 0.05, { wave: 'p25', vol: 0.07 - i * 0.008, release: 0.3 }));
