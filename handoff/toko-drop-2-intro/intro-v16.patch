+  }
+
+  // blend the game camera's off-axis view offset in, k = 0..1
+  _view(game, k) {
+    const v = game.view;
+    if (v && v.enabled && k > 0) this.cam.setViewOffset(v.fullWidth, v.fullHeight, v.offsetX * k, v.offsetY * k, v.width, v.height);
