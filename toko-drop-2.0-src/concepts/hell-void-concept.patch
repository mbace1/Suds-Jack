+  return max(max(left, far), pool);
+};
+// the cave's rock at a point: { rock, hgt, grain }
+const caveRock = (w, H) => {
+  const R = H.rock;
+  const hAt = (q) => noise(q.mul(R.swell)).mul(0.62).add(noise(q.mul(R.swell * 2.7).add(7.1)).mul(0.38));
