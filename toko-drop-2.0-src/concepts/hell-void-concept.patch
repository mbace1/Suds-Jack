+  let rock = v3(R.color).mul(tone).mul(grain);
+  rock = mix(rock, v3(R.basalt).mul(grain), smoothstep(R.patch[0], R.patch[1], noise(w.mul(R.patchScale).add(51.3))));   // old flow, darker and glassier
