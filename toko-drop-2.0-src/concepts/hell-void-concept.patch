+const v3 = (a) => vec3(...a);
+// the ray's run for a metre of fall: what lies `d` m under the point w is seen at w + run × d
+const viewRun = () => { const V = normalize(cameraPosition.sub(positionWorld)); return V.xz.div(max(V.y, 0.3)).negate(); };
+// the nearest two of nine jittered points (floor.js cellular)
+const cellular = (w, cell) => {
+  const u = w.div(cell), iu = tfloor(u), fu = fract(u);
+  let d1 = float(9), d2 = float(9), id = vec2(0);
+  for (let j = -1; j <= 1; j++) for (let i = -1; i <= 1; i++) {
+    const o = vec2(i, j), c = iu.add(o);
+    const d = length(o.add(vec2(hash(c), hash(c.add(vec2(19.1, 7.3)))).mul(0.76).add(0.12)).sub(fu));
+    const near = d.lessThan(d1);
+    d2 = select(near, d1, min(d2, d)); id = select(near, c, id); d1 = select(near, d, d1);
+  }
+  return { d1, d2, id };
+};
+
+// ── HELL ────────────────────────────────────────────────────────────────────────────────────────────────────
+// Second cut (owner, 2026-11-12: "less lava stream and more like a martian cavern with lava on the side and just
+// hellish feel. Moving lava or steaming eruptions help"). The floor is the cave's own: dark rust rock worn into
+// terraces, dust combed into its hollows, loose stones, hairline cracks. The lava is BESIDE it: a river down the
+// left side with boulders riding it, a lake along the far side under a wall the lava falls down. Everything is lit
+// from there. Two things go off on a beat: vents in the floor (their cracks light, then steam) and domes in the
+// lava (a swell, a burst, spatter and smoke).
+const beatS = (B, at) => fract(GEL_TIME.div(B.period).sub(stokeAt(B, at)));
+const ventSpots = (H, hx, hz) => H.vent.at.map(([fx, fz]) => [fx * hx, fz * hz]);
+const eruptSpots = (H, hx, hz) => H.erupt.at.map((e) => (e.side === 'left' ? [-(hx + H.bank.left + e.out), -hz + e.along * 2 * hz] : [-hx + e.along * 2 * hx, -(hz + H.bank.far + e.out)]));
+// metres into the lava (> 0) from its bank (< 0: metres back from it): a river down the left side, a lake along
+// the far side, a pool or two out on the right shelf
+const lavaField = (p, H, hx, hz) => {
+  const B = H.bank, wig = noise(p.mul(B.wig[0])).sub(0.5).mul(B.wig[1]).add(noise(p.mul(B.wig[0] * 3.1).add(4.7)).sub(0.5).mul(B.wig[1] * 0.35));
